# Optional configuration. Spring Boot does not load .env files by itself.
PORT=8080
MONGODB_URI=mongodb://localhost:27017/CV-DIVER
UPLOAD_DIR=./data/uploads
MAX_DOCUMENTS=70

# Gemini handles screenshot text when AI_ENABLED=true.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional local OCR fallback; point to the folder containing eng.traineddata.
TESSERACT_PATH=
