# Optional configuration. Spring Boot does not load .env files by itself.
PORT=8080
DATABASE_URL=jdbc:h2:file:./data/resumevault;AUTO_SERVER=TRUE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=
UPLOAD_DIR=./data/uploads
MAX_DOCUMENTS=70

# Install Tesseract OCR and point this at the directory containing eng.traineddata.
TESSERACT_PATH=

# Leave AI disabled unless you want to send extracted resume text to OpenAI.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
